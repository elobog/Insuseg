<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>23a99293-c93d-4838-84e5-42a1f7f0d6fe</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Archivos de conflicto de sincronización de OneDrive (sufijo "-igancio") — ver el mismo
         comentario en Insuseg.Analytics.Data.csproj. -->
    <Compile Remove="**\*-igancio.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Insuseg.Analytics.Data\Insuseg.Analytics.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Se copia a la raíz del publish (no a wwwroot — no hace falta que sea servible por HTTP) para
         que OPENSSL_CONF (App Setting en Azure) pueda apuntarle. Ver comentario dentro del archivo. -->
    <None Include="openssl-legacy.cnf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
