@page
@model Insuseg.Analytics.Api.Pages.Compras.SincronizacionModel
@{
    ViewData["Title"] = "Sincronización de compras";
}
<div class="insuseg-container">
    <h1>Sincronización de compras</h1>

    @if (!string.IsNullOrEmpty(Model.SyncSummary))
    {
        <div class="insuseg-summary">✅ @Model.SyncSummary</div>
    }
    @if (!string.IsNullOrEmpty(Model.SyncError))
    {
        <div class="insuseg-error">⚠️ @Model.SyncError</div>
    }

    <div class="insuseg-card">
        <form method="post" asp-page-handler="Sync">
            <button type="submit" class="insuseg-btn">Sincronizar ahora</button>
            <span style="margin-left:0.75rem; color:#696969; font-size:0.9rem;">
                Trae las órdenes de compra desde SAP y las guarda en la base.
            </span>
        </form>
    </div>

    <div class="insuseg-card">
        <h2 style="margin-top:0">@Model.Purchases.Count órdenes de compra guardadas</h2>
        <table class="insuseg-table">
            <thead>
                <tr>
                    <th>Proveedor</th>
                    <th>Código</th>
                    <th>Monto</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var purchase in Model.Purchases)
                {
                    <tr>
                        <td>@purchase.CardName</td>
                        <td>@purchase.CardCode</td>
                        <td>@purchase.Amount.ToString("N0")</td>
                        <td>@purchase.PurchaseDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
