@page
@model Insuseg.Analytics.Api.Pages.Compras.AnalisisModel
@{
    ViewData["Title"] = "Análisis de compras";
    var maxProveedor = Model.ComprasPorProveedor.Count > 0 ? Model.ComprasPorProveedor.Max(p => p.Monto) : 0m;
}
<div class="insuseg-container">
    <h1>Análisis de compras</h1>

    <form method="get" class="insuseg-filters">
        <div class="insuseg-field">
            <label for="desde">Desde</label>
            <input type="date" id="desde" name="Desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="insuseg-field">
            <label for="hasta">Hasta</label>
            <input type="date" id="hasta" name="Hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="insuseg-btn">Aplicar</button>
    </form>

    <div class="insuseg-kpi-row">
        <div class="insuseg-kpi">
            <div class="insuseg-kpi-label">Total comprado en el período</div>
            <div class="insuseg-kpi-value">$@Model.TotalComprado.ToString("N0")</div>
        </div>
        <div class="insuseg-kpi">
            <div class="insuseg-kpi-label">Órdenes en el período</div>
            <div class="insuseg-kpi-value">@Model.CantidadOrdenes</div>
        </div>
        <div class="insuseg-kpi">
            <div class="insuseg-kpi-label">Proveedor top</div>
            <div class="insuseg-kpi-value" style="font-size:1.1rem">@(Model.ProveedorTop?.CardName ?? "—")</div>
            @if (Model.ProveedorTop is not null)
            {
                <div class="insuseg-kpi-sub">$@Model.ProveedorTop.Monto.ToString("N0")</div>
            }
        </div>
    </div>

    <div class="insuseg-card">
        <h2 style="margin-top:0">Compras por proveedor</h2>
        <p style="color:#696969; font-size:0.9rem; margin-top:-0.5rem">
            SAP no tiene actividad de compras registrada desde 2022 — este módulo queda listo para cuando
            se retome, mostrando lo que hay hoy.
        </p>
        @if (Model.ComprasPorProveedor.Count == 0)
        {
            <p>No hay compras en el período seleccionado.</p>
        }
        else
        {
            <div class="insuseg-barchart">
                @foreach (var p in Model.ComprasPorProveedor)
                {
                    var pct = maxProveedor > 0 ? (double)(p.Monto / maxProveedor) * 100 : 0;
                    <div class="insuseg-bar-row" title="@p.CardName: $@p.Monto.ToString("N0") (@p.Cantidad órdenes)">
                        <span class="insuseg-bar-label">@p.CardName</span>
                        <div class="insuseg-bar-track"><div class="insuseg-bar-fill" style="width:@(pct.ToString("F1"))%"></div></div>
                        <span class="insuseg-bar-value">$@p.Monto.ToString("N0")</span>
                    </div>
                }
            </div>
        }
    </div>
</div>
