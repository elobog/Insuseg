@page
@model Insuseg.Analytics.Api.Pages.Inventario.SincronizacionModel
@{
    ViewData["Title"] = "Sincronización de inventario";
}
<div class="insuseg-container">
    <h1>Sincronización de inventario</h1>

    @if (!string.IsNullOrEmpty(Model.SyncSummary))
    {
        <div class="insuseg-summary">✅ @Model.SyncSummary</div>
    }
    @if (!string.IsNullOrEmpty(Model.SyncError))
    {
        <div class="insuseg-error">⚠️ @Model.SyncError</div>
    }

    <div class="insuseg-card">
        <form method="post" asp-page-handler="Sync">
            <button type="submit" class="insuseg-btn">Sincronizar ahora</button>
            <span style="margin-left:0.75rem; color:#696969; font-size:0.9rem;">
                Trae el catálogo de productos desde SAP y actualiza el stock — puede tardar unos segundos.
            </span>
        </form>
        <p style="color:#696969; font-size:0.9rem; margin-bottom:0">
            Si es la primera vez que se sincroniza inventario, conviene también apretar
            "Reprocesar historial completo" en <a asp-page="/Ventas/Sincronizacion">Ventas &gt; Sincronización</a>
            para traer el detalle de líneas de las órdenes ya existentes — sin eso, la tabla de rotación
            de este módulo va a aparecer vacía.
        </p>
    </div>

    <div class="insuseg-card">
        <h2 style="margin-top:0">@Model.Items.Count productos guardados</h2>
        <table class="insuseg-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Stock</th>
                    <th>Costo promedio</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ItemCode</td>
                        <td>@item.ItemName</td>
                        <td>@item.QuantityOnStock.ToString("N0")</td>
                        <td>$@item.MovingAveragePrice.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
