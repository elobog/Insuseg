@page
@model Insuseg.Analytics.Api.Pages.Inventario.AnalisisModel
@{
    ViewData["Title"] = "Análisis de inventario";
    var topInmovilizado = Model.ProductosSinMovimiento.Take(10).ToList();
    var maxInmovilizado = topInmovilizado.Count > 0 ? topInmovilizado.Max(p => p.ValorInmovilizado) : 0m;
}
<div class="insuseg-container">
    <h1>Análisis de inventario</h1>

    <form method="get" class="insuseg-filters">
        <div class="insuseg-field">
            <label for="desde">Desde</label>
            <input type="date" id="desde" name="Desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="insuseg-field">
            <label for="hasta">Hasta</label>
            <input type="date" id="hasta" name="Hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="insuseg-btn">Aplicar</button>
    </form>

    <div class="insuseg-kpi-row">
        <div class="insuseg-kpi">
            <div class="insuseg-kpi-label">SKUs con stock</div>
            <div class="insuseg-kpi-value">@Model.TotalSkus</div>
        </div>
        <div class="insuseg-kpi">
            <div class="insuseg-kpi-label">Unidades en stock</div>
            <div class="insuseg-kpi-value">@Model.TotalUnidadesEnStock.ToString("N0")</div>
        </div>
        <div class="insuseg-kpi">
            <div class="insuseg-kpi-label">Valor total de inventario</div>
            <div class="insuseg-kpi-value">$@Model.ValorTotalInventario.ToString("N0")</div>
        </div>
    </div>

    <div class="insuseg-card">
        <h2 style="margin-top:0">Top 10 — valor inmovilizado</h2>
        <p style="color:#696969; font-size:0.9rem; margin-top:-0.5rem">
            Los productos sin movimiento que más capital tienen inmovilizado en stock, de mayor a menor.
        </p>
        @if (topInmovilizado.Count == 0)
        {
            <p>No hay productos sin movimiento — todo el stock rotó en los últimos 60 días.</p>
        }
        else
        {
            <div class="insuseg-barchart">
                @foreach (var p in topInmovilizado)
                {
                    var pct = maxInmovilizado > 0 ? (double)(p.ValorInmovilizado / maxInmovilizado) * 100 : 0;
                    <div class="insuseg-bar-row" title="@p.ItemName: $@p.ValorInmovilizado.ToString("N0") (@p.Stock.ToString("N0") unidades)">
                        <span class="insuseg-bar-label">@p.ItemName</span>
                        <div class="insuseg-bar-track"><div class="insuseg-bar-fill" style="width:@(pct.ToString("F1"))%"></div></div>
                        <span class="insuseg-bar-value">$@p.ValorInmovilizado.ToString("N0")</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="insuseg-card">
        <h2 style="margin-top:0">Productos sin movimiento</h2>
        <p style="color:#696969; font-size:0.9rem; margin-top:-0.5rem">
            Productos con stock que no se han vendido en los últimos 60 días (no depende del filtro de fecha de
            arriba — se calcula sobre todo el historial). Ordenado por valor de inventario inmovilizado, para
            priorizar qué liquidar o dejar de comprar.
        </p>
        @if (Model.ProductosSinMovimiento.Count == 0)
        {
            <p>No hay productos sin movimiento — todo el stock rotó en los últimos 60 días.</p>
        }
        else
        {
            <div class="tabla-vertical-limitada">
                <table class="insuseg-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Stock</th>
                            <th>Valor inmovilizado</th>
                            <th>Última venta</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.ProductosSinMovimiento)
                        {
                            <tr>
                                <td>@p.ItemCode</td>
                                <td>@p.ItemName</td>
                                <td>@p.Stock.ToString("N0")</td>
                                <td>$@p.ValorInmovilizado.ToString("N0")</td>
                                <td>@(p.UltimaVenta?.ToString("yyyy-MM-dd") ?? "Nunca")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="insuseg-card">
        <h2 style="margin-top:0">Índice de rotación</h2>
        <p style="color:#696969; font-size:0.9rem; margin-top:-0.5rem">
            Unidades vendidas en el período seleccionado ÷ stock actual, de peor a mejor rotación. Excluye
            productos sin stock (necesitan reposición, no es un problema de sobrestock).
        </p>
        @if (Model.RotacionProductos.Count == 0)
        {
            <p>No hay productos con stock para calcular rotación.</p>
        }
        else
        {
            <div class="tabla-vertical-limitada">
                <table class="insuseg-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Stock</th>
                            <th>Unidades vendidas</th>
                            <th>Índice de rotación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.RotacionProductos)
                        {
                            <tr>
                                <td>@r.ItemCode</td>
                                <td>@r.ItemName</td>
                                <td>@r.Stock.ToString("N0")</td>
                                <td>@r.UnidadesVendidas.ToString("N0")</td>
                                <td>@r.IndiceRotacion.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
